rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isGoogleUser() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'google.com';
    }

    function isAdmin() {
      return isGoogleUser()
        && (request.auth.uid == 'sc86ijhTeih8DyHayLFTmKMHSCl2'
          || exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }

    match /admins/{userId} {
      allow read: if isGoogleUser() && request.auth.uid == userId;
      allow write: if false;
    }

    match /profiles/{userId} {
      allow read, create, update: if isGoogleUser() && request.auth.uid == userId;
      allow delete: if false;
    }

    match /questions/{questionId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /communityContent/{contentId} {
      allow read: if true;
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    match /leaderboard/{entryId} {
      allow read: if true;
      allow write: if false;
    }

    match /questionReports/{reportId} {
      allow create: if isGoogleUser()
        && request.resource.data.keys().hasOnly(['questionId', 'reason', 'details', 'uid', 'name', 'status', 'createdAt'])
        && request.resource.data.questionId is string
        && request.resource.data.questionId.size() > 0
        && request.resource.data.questionId.size() <= 100
        && request.resource.data.reason in ['incorrect_answer', 'ambiguous', 'outdated', 'typo', 'other']
        && request.resource.data.details is string
        && request.resource.data.details.size() <= 500
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 80
        && request.resource.data.status == 'open'
        && request.resource.data.createdAt is int;
      allow read: if isAdmin();
      allow update, delete: if isAdmin();
    }

    match /gameEvents/{eventId} {
      allow create: if isGoogleUser()
        && request.resource.data.keys().hasOnly(['uid', 'eventType', 'category', 'dateKey', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.eventType in ['round_started', 'round_completed', 'challenge_created', 'challenge_joined']
        && request.resource.data.category is string
        && request.resource.data.category.size() <= 40
        && request.resource.data.dateKey is string
        && request.resource.data.dateKey.size() == 10
        && request.resource.data.createdAt is int;
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    match /polls/current/votes/{userId} {
      allow read: if true;
      allow create, update: if isGoogleUser()
        && request.auth.uid == userId
        && request.resource.data.optionId in get(/databases/$(database)/documents/communityContent/current).data.pollOptions;
      allow delete: if false;
    }
  }
}